# ==== Sổ Đoàn viên số — cấu hình môi trường ====
# (deploy.sh tự sinh file .env với JWT_SECRET ngẫu nhiên — sửa các dòng sau nếu cần)

# Port backend lắng nghe
PORT=3000

# Chế độ ledger: simulator (VPS 1GB) | fabric (cần mạng Hyperledger Fabric + >=4GB RAM)
LEDGER_MODE=simulator

# KHÓA ký JWT — deploy.sh tự sinh; nếu đổi, người dùng phải đăng nhập lại
JWT_SECRET=change-me-deploy-se-sinh-khoa-moi
JWT_EXPIRES=12h

# ==== Lớp AI (tùy chọn) — chuẩn OpenAI-compatible ====
# OpenAI:  https://api.openai.com/v1        model: gpt-4o-mini (vision: đọc ảnh VNeID/CCCD)
# Ollama (chạy trên máy khác): http://<ip-ollama>:11434/v1   model: qwen2.5:7b
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Model riêng cho đọc ảnh (nếu khác AI_MODEL, vd: gpt-4o)
#AI_VISION_MODEL=gpt-4o-mini

# ==== Định danh điện tử VNeID/eKYC (tùy chọn) ====
# mock = mô phỏng để demo | http = nhà cung cấp thật khi trường đã ký hợp đồng
VNEID_PROVIDER=mock
#VNEID_BASE_URL=https://<endpoint-ekyc-cua-nha-cung-cap>
#VNEID_API_KEY=
